<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IngresosGastosApp">
        <activity
            android:name=".PerfilActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />
        <activity
            android:name=".TerminosPrivacidadActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />
        <activity
            android:name=".CambiarContrasenaActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />
        <activity
            android:name=".EditarMetaActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />
        <activity
            android:name=".GestionarAhorrosActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name=".GastosRecientesAdapter"
            android:exported="false" />
        <activity
            android:name=".EditarIngresoActivity"
            android:exported="false" />
        <activity
            android:name=".EditarGastoActivity"
            android:exported="false" />
        <activity
            android:name=".GastosActivity"
            android:exported="false" />
        <activity
            android:name=".IngresosActivity"
            android:exported="false" />
        <activity
            android:name="com.example.ingresosgastosapp.HistorialGastosActivity"
            android:exported="false" />
        <activity
            android:name=".HistorialActivity"
            android:exported="false" />
        <activity
            android:name=".AnalisisActivity"
            android:exported="false" />
        <activity
            android:name=".AgregarIngresoActivity"
            android:exported="false" />
        <activity
            android:name=".AgregarGastoActivity"
            android:exported="false" />
        <activity
            android:name=".ResumenPresupuestoActivity"
            android:exported="false" />
        <activity
            android:name=".AhorrosActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainMenuActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"/>
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:exported="false"
            android:theme="@style/Theme.IngresosGastosApp.Crop"
            tools:replace="android:exported,android:theme" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>