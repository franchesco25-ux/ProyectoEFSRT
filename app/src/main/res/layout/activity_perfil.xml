<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".PerfilActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="120dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/btnBackPerfil"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/white" />
            </RelativeLayout>

            <!-- Profile Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_person"
                        app:contentPadding="15dp"
                        app:strokeColor="@color/green_accent"
                        app:strokeWidth="2dp"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        android:background="#20FFFFFF"
                        app:tint="@color/text_on_dark_muted" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvNombreUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Nombre Usuario"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmailUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="usuario@correo.com"
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>

            <!-- Sections Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <!-- CUENTA Y SEGURIDAD -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="16dp"
                    android:text="CUENTA Y SEGURIDAD"
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_menu"
                    android:paddingVertical="8dp"
                    android:orientation="vertical">

                    <include 
                        layout="@layout/item_profile_option" 
                        android:id="@+id/rowChangePass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#0DFFFFFF" />
                    <include 
                        layout="@layout/item_profile_switch" 
                        android:id="@+id/rowFaceId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- PREFERENCIAS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="16dp"
                    android:text="PREFERENCIAS"
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_menu"
                    android:paddingVertical="8dp"
                    android:orientation="vertical">

                    <include 
                        layout="@layout/item_profile_value" 
                        android:id="@+id/rowCurrency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#0DFFFFFF" />
                    <include 
                        layout="@layout/item_profile_switch" 
                        android:id="@+id/rowNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#0DFFFFFF" />
                    <include 
                        layout="@layout/item_profile_value" 
                        android:id="@+id/rowLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- AYUDA Y SOPORTE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="16dp"
                    android:text="AYUDA Y SOPORTE"
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_menu"
                    android:paddingVertical="8dp"
                    android:orientation="vertical">

                    <include 
                        layout="@layout/item_profile_option" 
                        android:id="@+id/rowPrivacy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- Logout -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="40dp"
                    android:backgroundTint="@color/bg_dark_card"
                    android:text="Cerrar Sesión"
                    android:textColor="@color/danger_red"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:icon="@android:drawable/ic_lock_power_off"
                    app:iconGravity="textStart"
                    app:iconTint="@color/danger_red"
                    app:strokeColor="#0DFFFFFF"
                    app:strokeWidth="1dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="Versión 2.4.0 (Build 892)"
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="10sp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/layout_bottom_navigation"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
