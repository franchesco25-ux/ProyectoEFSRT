<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stitch_background"
    tools:context=".PerfilActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPerfil"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/stitch_background"
        android:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_stitch_card"
                android:backgroundTint="#1AFFFFFF"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Perfil"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_marginTop="10dp"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_stitch_card"
                android:backgroundTint="#1AFFFFFF"
                android:src="@drawable/ic_settings"
                app:tint="@color/white" />
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarPerfil">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgPerfil"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:padding="4dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person"
                        app:contentPadding="15dp"
                        app:strokeColor="@color/green_accent"
                        app:strokeWidth="2dp"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        android:background="#20FFFFFF"
                        app:tint="@color/text_on_dark_muted" />

                    <ImageButton
                        android:id="@+id/btnCambiarFoto"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_stitch_fab"
                        android:src="@drawable/ic_camera"
                        android:scaleType="centerInside"
                        android:padding="6dp"
                        app:tint="@color/stitch_background"
                        android:contentDescription="Cambiar foto de perfil" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvNombreUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Nombre Usuario"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmailUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="usuario@correo.com"
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="16dp"
                    android:text="PLAN PREMIUM"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/stitch_background"
                    app:backgroundTint="@color/green_accent"
                    app:cornerRadius="20dp"
                    android:paddingHorizontal="20dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>

            <!-- Sections Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <!-- CUENTA Y SEGURIDAD -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="16dp"
                    android:text="CUENTA Y SEGURIDAD"
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_menu"
                    android:orientation="vertical">

                    <include 
                        layout="@layout/item_profile_option" 
                        android:id="@+id/rowChangePass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"/>

                    <View android:layout_width="match_parent"
                          android:layout_height="1dp"
                          android:background="#0DFFFFFF" />

                    <include 
                        layout="@layout/item_profile_switch" 
                        android:id="@+id/rowFaceId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <View android:layout_width="match_parent"
                          android:layout_height="1dp"
                          android:background="#0DFFFFFF" />

                    <include 
                        layout="@layout/item_profile_status" 
                        android:id="@+id/rowVerificacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"/>

                </LinearLayout>

                <!-- PREFERENCIAS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="16dp"
                    android:text="PREFERENCIAS"
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_menu"
                    android:paddingVertical="8dp"
                    android:orientation="vertical">

                    <include 
                        layout="@layout/item_profile_value" 
                        android:id="@+id/rowCurrency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#0DFFFFFF" />

                    <include
                        layout="@layout/item_profile_switch" 
                        android:id="@+id/rowNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#0DFFFFFF" />
                    <include 
                        layout="@layout/item_profile_value" 
                        android:id="@+id/rowLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"/>

                </LinearLayout>

                <!-- AYUDA Y SOPORTE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="16dp"
                    android:text="AYUDA Y SOPORTE"
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_menu"
                    android:paddingVertical="8dp"
                    android:orientation="vertical">

                    <include 
                        layout="@layout/item_profile_option" 
                        android:id="@+id/rowHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#0DFFFFFF" />

                    <include 
                        layout="@layout/item_profile_option" 
                        android:id="@+id/rowPrivacy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"/>

                </LinearLayout>

                <!-- Logout -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="40dp"
                    android:backgroundTint="@color/bg_dark_card"
                    android:text="Cerrar Sesión"
                    android:textColor="@color/danger_red"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:icon="@android:drawable/ic_lock_power_off"
                    app:iconGravity="textStart"
                    app:iconTint="@color/danger_red"
                    app:strokeColor="#0DFFFFFF"
                    app:strokeWidth="1dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="Versión 2.4.0 (Build 892)"
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="10sp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <include
        layout="@layout/layout_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

