<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.IngresosGastosApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_accent</item>
        <item name="colorPrimaryContainer">@color/bg_dark_card</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/stitch_background</item>
        <item name="android:navigationBarColor">@color/stitch_background</item>
        <item name="android:windowBackground">@color/stitch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="shapeAppearanceOverlay">@style/CircleImage</item>
    </style>

    <style name="Theme.IngresosGastosApp" parent="Base.Theme.IngresosGastosApp" />

    <!-- Tema para el CropImageActivity con ActionBar visible -->
    <style name="Theme.IngresosGastosApp.Crop" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/green_accent</item>
        <item name="colorPrimaryVariant">@color/stitch_background</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/stitch_background</item>
        <item name="android:navigationBarColor">@color/stitch_background</item>
        <item name="android:windowBackground">@color/stitch_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

    <!-- DatePicker dark theme -->
    <style name="DatePickerTheme" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">@color/stitch_primary</item>
        <item name="android:windowBackground">@color/stitch_background</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">#B3FFFFFF</item>
    </style>

    <!-- AlertDialog dark theme -->
    <style name="AlertDialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:background">@color/stitch_background</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="colorAccent">@color/stitch_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/AlertDialogPositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertDialogNegativeButton</item>
    </style>

    <style name="AlertDialogPositiveButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#EF4444</item>
    </style>

    <style name="AlertDialogNegativeButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#B3FFFFFF</item>
    </style>
</resources>
